# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Application Settings
NODE_ENV="development"
PORT=3000
APP_NAME="Master TypeScript Enterprise Architecture Platform"
APP_TIMEZONE="Asia/Riyadh"
APP_DEFAULT_LOCALE="ar"

# Database Configuration (PostgreSQL / Connection Pool)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_db"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Security & Sessions
JWT_SECRET="enterprise-master-jwt-secret-key-super-secure"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="enterprise-session-security-secret-key"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# Storage Service Configuration
STORAGE_DRIVER="local" # local, s3, gcs
STORAGE_UPLOAD_DIR="./storage/uploads"
STORAGE_MAX_FILE_SIZE_MB=50

# Email Service (SMTP Adapter)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_user"
SMTP_PASS="smtp_pass"
EMAIL_FROM_ADDRESS="no-reply@enterprise.local"
EMAIL_FROM_NAME="Enterprise Architecture System"

# SMS Service Provider Adapter
SMS_PROVIDER="mock_twil"
SMS_ACCOUNT_SID="AC_mock_account_sid"
SMS_AUTH_TOKEN="mock_auth_token"
SMS_FROM_NUMBER="+15005550006"

# WhatsApp Service Provider Adapter
WHATSAPP_PROVIDER="meta_cloud"
WHATSAPP_PHONE_NUMBER_ID="109876543210"
WHATSAPP_ACCESS_TOKEN="mock_meta_wa_token"

# PayPal Payment Gateway Adapter
PAYPAL_MODE="sandbox" # sandbox or live
PAYPAL_CLIENT_ID="mock_paypal_client_id"
PAYPAL_CLIENT_SECRET="mock_paypal_secret"
PAYPAL_WEBHOOK_ID="mock_webhook_id"

